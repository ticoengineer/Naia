<configuration>

	<connectionStrings>
		<add name="WIN_AUT" providerName="System.Data.SqlClient" connectionString="Data Source=.; 
                          Initial Catalog=NaiaInc; 
                          Integrated Security=True;
                          TrustServerCertificate=True;
                          Encrypt=False;"/>


		<add name="SQL_AUT" providerName="System.Data.SqlClient" connectionString="Data Source=.; 
                          Initial Catalog=NaiaInc; 
                          Persist Security Info=True;
                          User ID=sa;
                          Password=;"/>
	</connectionStrings>


	<appSettings>
		<!-- Instituciones y sesion (existentes) -->
		<add key="SP_INSERTA_INSTITUCIONES" value="dbo.SP_INSERTA_INSTITUCIONES" />
